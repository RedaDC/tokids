# ============================================================
# TeeDesign AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://teedesign:teedesign_pass@localhost:5432/teedesign_db
DATABASE_URL_SYNC=postgresql+psycopg2://teedesign:teedesign_pass@localhost:5432/teedesign_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT Auth ---
JWT_SECRET_KEY=change-this-jwt-secret-too
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Default Admin User (created on first startup) ---
ADMIN_EMAIL=admin@teedesign.ai
ADMIN_PASSWORD=TeeDesign2024!
ADMIN_USERNAME=admin

# --- LLM Providers ---
# Primary LLM provider: openai | anthropic | google
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (optional fallback)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

# --- Image Generation Providers ---
# Primary image provider: openai | replicate | stub
IMAGE_PROVIDER=openai

# OpenAI DALL-E 3
# Uses OPENAI_API_KEY above
DALLE_MODEL=dall-e-3
DALLE_SIZE=1024x1024
DALLE_QUALITY=hd

# Replicate (alternative)
REPLICATE_API_KEY=
REPLICATE_MODEL=black-forest-labs/flux-schnell

# --- Image Processing ---
EXPORT_WIDTH=5000
EXPORT_HEIGHT=5500
PREVIEW_WIDTH=600
PREVIEW_HEIGHT=600
MIN_QUALITY_SCORE=70

# --- Storage ---
STORAGE_PATH=./assets
MASTER_FILES_PATH=./assets/generated
APPROVED_FILES_PATH=./assets/approved
PREVIEWS_PATH=./assets/previews
EXPORTS_PATH=./assets/exports

# --- Langfuse Observability (optional) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Cost Controls ---
MAX_DAILY_SPEND_USD=50.00
MAX_MONTHLY_SPEND_USD=500.00
MAX_RETRIES_PER_DESIGN=3
MAX_WORKFLOW_STEPS=50

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TeeDesign AI
NEXT_PUBLIC_VERSION=1.0.0
